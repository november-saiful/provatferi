# Supabase (public keys are safe to expose in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL - used for links in emails and absolute asset paths
NEXT_PUBLIC_SITE_URL=https://home.provatferi2009.workers.dev

# Recruitment link shown in the nav / hero
NEXT_PUBLIC_RECRUITMENT_URL=https://example.com/recruitment

# Public committee contact info
NEXT_PUBLIC_CONTACT_EMAIL=provatferi2009@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+880 1839-858853

# --- Edge function secrets (never put these in the client) ---
# Set in Supabase Edge Function secrets, NOT in .env
# RESEND_API_KEY=re_...
